PORT=3000
JWT_SECRET=change-this-secret-in-production-please
DB_PATH=./database/attendance.db
QR_TOKEN_TTL_SECONDS=25
ADMIN_REGISTRATION_KEY=change-this-admin-reg-key

# Database engine — optional. Leave unset (or "sqlite") to use the existing
# SQLite database at DB_PATH, exactly as before. Set to "postgres" to run
# against PostgreSQL instead — DATABASE_URL then becomes required, and the
# target must already have the schema applied (see server/db/postgres/schema.sql);
# this app never auto-creates a Postgres schema, and a failed Postgres
# connection never silently falls back to SQLite.
# DB_ENGINE=sqlite
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Email notifications — optional. Leave ALL of these unset (or partially set)
# and the app runs in mock/dev mode: emails are generated and logged, never
# actually sent. Only when every SMTP_* value below is present does real
# sending switch on. Never commit real credentials here.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Smart Attendance <no-reply@example.com>"

# LMS integration — optional. Leave unset and the app uses the built-in Mock
# LMS provider (clearly labeled as such in the UI, safe to demo with zero
# config). Only when ALL THREE of these are set does the app attempt a real
# provider connection instead — and even then, that connection is exercised
# only when an admin explicitly clicks Test Connection / Sync, never automatically.
# LMS_PROVIDER=generic
# LMS_BASE_URL=https://your-lms.example.com
# LMS_API_KEY=your-lms-api-key
